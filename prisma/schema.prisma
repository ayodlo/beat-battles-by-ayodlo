generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  battleId  String
  fileKey   String   @unique
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  @@unique([userId, battleId])
}